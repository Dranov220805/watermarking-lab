# Server-side Next.js proxy target for /api/* -> Python backend
# (Also falls back to WM_API_URL if set)
API_PROXY_TARGET=http://127.0.0.1:8000
PROXY_TIMEOUT_MS=300000
MAX_BODY_SIZE=120mb

# Browser-accessible settings (NEXT_PUBLIC_*)
# Leave NEXT_PUBLIC_API_URL empty to route through Next.js /api/* proxy rewrite,
# or set to e.g. http://localhost:8000 to call the backend directly.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_TITLE=DCT Watermarking Lab
NEXT_PUBLIC_DEFAULT_ALPHA=25
NEXT_PUBLIC_DEFAULT_SECRET_KEY=my-secret-key
NEXT_PUBLIC_DEFAULT_METHOD=dct
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=180000
