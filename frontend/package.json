{
  "name": "dct-watermark-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api": "cd ../backend && python -m uvicorn server:app --port 8000",
    "dev:all": "concurrently -k -n api,web \"npm:api\" \"npm:dev\"",
    "start:all": "concurrently -k -n api,web \"npm:api\" \"npm:start\""
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "concurrently": "^9.0.0"
  }
}