# Server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TITLE=DCT watermark API

# CORS (comma-separated list of allowed frontend origins; also falls back to WM_CORS)
CORS_ORIGINS=http://localhost:3000

# Temporary Image Storage (leave empty for system temp folder; also falls back to WM_STORE)
STORAGE_DIR=
STORAGE_TTL_SECONDS=7200
CLEANUP_INTERVAL_SECONDS=600
MAX_UPLOAD_MB=100

# Watermark Defaults
DEFAULT_ALPHA=25
DEFAULT_NULL_TRIALS=40
MAX_NULL_TRIALS=200
