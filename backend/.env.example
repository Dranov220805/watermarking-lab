# Server
APP_HOST=127.0.0.1
APP_PORT=8000
SYSTEM_NAME=WM.WatermarkService

# API Routing
API_PREFIX=/api
API_VERSION=v1

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000

# Temporary Image Storage (leave empty to auto-create a system temp directory)
STORAGE_DIR=
STORAGE_TTL_SECONDS=7200
CLEANUP_INTERVAL_SECONDS=600
MAX_UPLOAD_MB=100

# Watermark Defaults
DEFAULT_ALPHA=25
DEFAULT_NULL_TRIALS=40
MAX_NULL_TRIALS=200
